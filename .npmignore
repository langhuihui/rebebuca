# Development config files
.env*
!.env.production

# Build artifacts not needed for npm.
# Do not use "dist/" alone: once the parent is ignored, "!dist/server" cannot re-include it.
dist/*
!dist/server/
!dist/server/**

# Source files (compiled assets are in dist/server)
src/

# Test / dev files
*.sh
test-stderr.sh
scripts/

# IDE / editor files
.vscode/
.cursor/
.windsurf/
.kiro/
.factory/
.agent/
.claude/
.codebuddy/
.vibe/

# Docs not needed at runtime
docs/
public-website/
*.md
!README.md

# Config / build tools (not needed at runtime)
vite.config.ts
vite.website.config.ts
tsconfig*.json
auto-imports.d.ts
components.d.ts
index.html
website.html

# Other
pnpm-lock.yaml
.github/
shared/
server/
