{
  "name": "rebebuca",
  "version": "1.0.11",
  "description": "Run Configuration Management Tool — launch via npx rebebuca",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langhuihui/rebebuca.git"
  },
  "type": "module",
  "bin": {
    "rebebuca": "bin/rebebuca.js"
  },
  "files": [
    "bin",
    "node-server",
    "web-public"
  ],
  "engines": {
    "node": ">=18.11.0"
  },
  "scripts": {
    "prepublishOnly": "node scripts/verify-npm-dist.mjs",
    "prepack": "node scripts/verify-npm-dist.mjs",
    "dev": "concurrently -n backend,server -c blue,green \"pnpm run dev:backend\" \"pnpm run dev:server\"",
    "dev:web": "cross-env VITE_BACKEND=mock vite --port 6173",
    "dev:backend": "node --watch bin/rebebuca.js --port 3000 --no-open",
    "dev:server": "cross-env VITE_BACKEND=server VITE_SERVER_URL=ws://127.0.0.1:3000/ws vite --port 6173",
    "dev:website": "cross-env VITE_BACKEND=mock vite --config vite.website.config.ts",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "cross-env VITE_BUILD_TARGET=web VITE_BACKEND=mock vue-tsc --noEmit && vite build",
    "build:server": "cross-env VITE_BACKEND=server VITE_DEV_MODE=true vue-tsc --noEmit && vite build",
    "build:server-app": "pnpm run build:nuxt && node scripts/copy-server-static.mjs",
    "build:vite-server": "cross-env VITE_BACKEND=server VITE_BUILD_TARGET=server vue-tsc --noEmit && vite build",
    "build:nuxt": "nuxi generate",
    "build:website": "cross-env VITE_BACKEND=mock vue-tsc --noEmit -p tsconfig.website.json && vite build --config vite.website.config.ts && mv dist/website/website.html dist/website/index.html",
    "preview": "vite preview",
    "start": "node bin/rebebuca.js",
    "release": "./scripts/release.sh",
    "republish": "./scripts/republish.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.9",
    "@ai-sdk/google": "^3.0.6",
    "@ai-sdk/openai": "^3.0.8",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@vicons/fluent": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vicons/tabler": "^0.13.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.1",
    "@vue-flow/minimap": "^1.5.4",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.28",
    "ansi-to-html": "^0.7.2",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.11.1",
    "json5": "^2.2.3",
    "marked": "^17.0.1",
    "mime-types": "^2.1.35",
    "naive-ui": "^2.43.2",
    "node-pty": "^1.1.0",
    "open": "^11.0.0",
    "pinia": "^3.0.3",
    "ssh2": "^1.16.0",
    "tree-kill": "^1.2.2",
    "vue": "^3.5.30",
    "vue-i18n": "9",
    "vue-router": "^4.5.1",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@pinia/nuxt": "^0.5.5",
    "@types/file-saver": "^2.0.7",
    "@vitejs/plugin-vue": "^6.0.5",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "nuxt": "^3.14.1590",
    "sass": "^1.93.2",
    "typescript": "~5.6.2",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.2.7",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-static-copy": "^3.1.4",
    "vue-tsc": "^2.1.10"
  }
}
