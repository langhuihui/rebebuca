{
  "name": "rebebuca",
  "private": true,
  "version": "0.2.6",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "VITE_BACKEND=mock vite --port 5173",
    "dev:website": "VITE_BACKEND=mock vite --config vite.website.config.ts",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "VITE_BUILD_TARGET=web VITE_BACKEND=mock vue-tsc --noEmit && vite build",
    "build:website": "VITE_BACKEND=mock vue-tsc --noEmit && vite build --config vite.website.config.ts && mv dist/website/website.html dist/website/index.html",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "release": "./scripts/release.sh",
    "republish": "./scripts/republish.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "~2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@vicons/ionicons5": "^0.13.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-html": "^0.7.2",
    "highlight.js": "^11.11.1",
    "json5": "^2.2.3",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-i18n": "9",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.3",
    "sass": "^1.93.2",
    "typescript": "~5.6.2",
    "vite": "^7.2.7",
    "vite-plugin-static-copy": "^3.1.4",
    "vue-tsc": "^2.1.10"
  }
}