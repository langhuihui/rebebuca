{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rebebuca",
  "version": "0.5.5",
  "identifier": "com.rebebuca.runner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rebebuca",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": true
    },
    "tray-icon": {
      "all": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEMTI3NTkxRERBODJEOTYKUldTV0xhamRrWFVTN1M5RGJlNzJ4SHFKR3VXb2R3T2hkWEtqVUZzQ2tsQmg5a2dkaFBQU1YrelU=",
      "endpoints": [
        "https://download.m7s.live/rb/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "shell-integration/*",
      "rebebuca-remote-agent",
      "rebebuca-remote-agent-x86_64",
      "rebebuca-remote-agent-aarch64"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": ""
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": [
          "en-US",
          "zh-CN"
        ]
      },
      "nsis": null
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  }
}