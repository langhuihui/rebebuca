    {
      "id": "scale",
      "name": "视频缩放",
      "description": "调整视频分辨率到指定尺寸",
      "icon": "📐",
      "category": "transform",
      "filterComplex": "[0:v]scale=1280:720[v]",
      "nodes": [
        {
          "id": "input-1",
          "type": "input",
          "position": { "x": 0, "y": 0 },
          "data": {
            "name": "输入视频",
            "streamType": "v",
            "label": "输入"
          }
        },
        {
          "id": "filter-scale",
          "type": "filter",
          "position": { "x": 200, "y": 0 },
          "data": {
            "name": "缩放",
            "filterId": "scale",
            "label": "scale",
            "icon": "📐",
            "enabled": true,
            "params": {
              "width": 1280,
              "height": 720,
              "flags": "bicubic"
            }
          }
        },
        {
          "id": "output-1",
          "type": "output",
          "position": { "x": 400, "y": 0 },
          "data": {
            "name": "输出视频",
            "label": "输出"
          }
        }
      ],
      "edges": [
        {
          "id": "edge-1",
          "source": "input-1",
          "target": "filter-scale",
          "sourceHandle": "v",
          "targetHandle": "v"
        },
        {
          "id": "edge-2",
          "source": "filter-scale",
          "target": "output-1",
          "sourceHandle": "v",
          "targetHandle": "v"
        }
      ]
    },
